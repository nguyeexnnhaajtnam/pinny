PINNY_ENVIRONMENT=development
PINNY_LOG_LEVEL=INFO
PINNY_DATABASE_HOST=localhost
PINNY_DATABASE_PORT=5432
PINNY_DATABASE_NAME=pinny
PINNY_DATABASE_USER=pinny
PINNY_DATABASE_PASSWORD=pinny
PINNY_DATABASE_CONNECT_TIMEOUT=3.0
PINNY_IDENTITY_PROVIDER=development
# DEVELOPMENT ONLY. Replace this provider with trusted Pinus authentication before production.
PINNY_DEV_USER_ID=dev-user
# Select one provider. Provider selection is server-side and requires a service restart.
LLM_PROVIDER=openai
# Server-side secret. Set locally; never expose it to clients or commit a real value.
PINNY_OPENAI_API_KEY=
PINNY_OPENAI_MODEL=gpt-5-mini
PINNY_OPENAI_TIMEOUT=30.0
# Required only when LLM_PROVIDER=gemini. Keep this value server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30.0
PINNY_CHAT_MAX_OUTPUT_TOKENS=2048
PINNY_CHAT_MAX_CONTEXT_CHARACTERS=100000
PINNY_CHAT_STALE_GENERATION_SECONDS=300

POSTGRES_DB=pinny
POSTGRES_USER=pinny
POSTGRES_PASSWORD=pinny
